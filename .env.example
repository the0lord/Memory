# Copy to .env in this folder, fill in, then:  docker compose up -d
#   cp .env.example .env   &&   nano .env   &&   docker compose up -d
# .env is gitignored — never commit real tokens. (Or run ./setup.sh to generate one.)

# --- hosted server: REQUIRED ---------------------------------------------
# One token per developer as token=author, comma-separated.
# Generate a token with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SOLMEM_TOKENS=alice=CHANGE_ME_alice_token,bob=CHANGE_ME_bob_token

# Tokens allowed to evolve / rollback the shared brain (recommended).
SOLMEM_ADMIN_TOKENS=ops=CHANGE_ME_ops_token

# --- HTTPS only (docker-compose.https.yml) -------------------------------
# Your domain; Caddy auto-provisions a Let's Encrypt cert for it.
SOLMEM_DOMAIN=memory.yourco.com

# --- optional: semantic recall via Mistral embeddings --------------------
# Leave blank to use keyword similarity (no API).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_COOLDOWN_SECS=20
