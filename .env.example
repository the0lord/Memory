# Copy to selfmod/.env and fill in. No quotes, no spaces around '=', one per line.
MISTRAL_API_KEY=your-rotated-key-here

# optional — defaults shown below
MISTRAL_MODEL=mistral-large-latest

# Free-tier Mistral Large is 2-5 RPM. Default cooldown is 20 s between calls
# (~3 RPM). Lower only if you have a paid plan.
MISTRAL_COOLDOWN_SECS=20
